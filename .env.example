# Copy to .env (local) and add the same values to the hosting environment.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase > Project Settings > API > service_role (SECRET: server only, never prefix with NEXT_PUBLIC_)
# Used for the roster check at sign-up, creating sign-up codes / invitation / reset links,
# and the scripts/ folder.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public address of the deployed site, used in invitation and reset links. No trailing slash.
# Read at runtime, so change it without rebuilding. Not needed for `npm run dev`
# (links then use the address you opened, e.g. http://localhost:3000). On Netlify it
# can be left out (Netlify's own URL is used); on EC2 set it in the server's environment.
SITE_URL=https://mentor-booking.dev.elicer.io

# Outgoing email (the app sends its own auth emails; see README > Email).
# Brevo: Settings > SMTP & API > SMTP tab.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
# Must be a sender verified in Brevo (Senders, domains & dedicated IPs).
EMAIL_FROM="멘토링 예약 <no-reply@your-domain>"
# Optional. Max emails per rolling hour across the whole app (default 50).
EMAIL_HOURLY_LIMIT=150
